<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Golden snapshot sits next to the test binary; regenerate with MMOCORE_REGEN=1. -->
  <ItemGroup>
    <None Update="golden-tick-state.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- GameServer is OutputType=Exe; referencing it from a test project is supported. -->
  <ItemGroup>
    <ProjectReference Include="..\..\GameServer\GameServer.csproj" />
  </ItemGroup>

</Project>
